+def pramana_learned_prior(kb, features, cfg) -> dict:
+    """[pramana] Advisory prior for the Decision LLM when FDAGENTS_PRAMANA_CONTEXT names a
+    pramana context.md: its text plus the knowledge-base cases matched to this design's
+    features (the public release computes no matches in staged mode). Never gates anything."""
+    path = os.environ.get("FDAGENTS_PRAMANA_CONTEXT")
+    if not path:
+        return {}
+    prior = {
+        "source": "pramana",
+        "authority": "prior measured on OTHER training designs; advisory only, never gates",
+        "context_md": Path(path).read_text(encoding="utf-8"),
+    }
+    try:
+        if kb is not None and features is not None:
+            prior["matched_cases"] = kb.render_matches(kb.match(features, cfg=cfg))
+    except Exception as exc:  # noqa: BLE001 - advisory data must never break a run
+        prior["matched_cases_error"] = str(exc)[:200]
+    return prior
+
